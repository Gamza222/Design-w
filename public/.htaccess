DirectoryIndex index.html
DirectorySlash On
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Read only the original path: slashes inside UTM/query values are untouched.
  # Raw captures plus NE preserve escaped path characters; the query is retained.
  RewriteCond %{THE_REQUEST} \s/{2,}([^?\s]*)[?\s]
  RewriteRule ^ https://designseichas.ru/%1 [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)/{2,}([^?\s]*)[?\s]
  RewriteRule ^ https://designseichas.ru/%1/%2 [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^www\.designseichas\.ru(?::\d+)?$ [NC]
  RewriteRule ^ https://designseichas.ru%{REQUEST_URI} [R=301,L]
  # Keep explicit index.html aliases aligned with canonical directory URLs.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <Files "__spa-fallback.html">
    Header always set X-Robots-Tag "noindex"
  </Files>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:css|js|woff2|png|jpe?g|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Unhashed analytics entrypoint must pick up future counter/configuration changes.
  <Files "metrika.js">
    Header set Cache-Control "no-cache"
  </Files>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
